  "steps": [
    {"text": "Bandnudeln in einem separaten Topf nach Packungsanweisung bissfest kochen, abgießen und beiseitestellen. Zucchini würfeln, Bohnen in Stücke schneiden und den gefrorenen Lachs in ca. 15 Würfel schneiden."},
    {"text": "Zwiebel und Knoblauch in den Mixbehälter geben und zerkleinern. Mit dem Spatel nach unten schieben.",
     "machine": {"program": "manuel", "seconds": 5, "speed": 5}},
    {"text": "Rühraufsatz einsetzen. Butter einwiegen.", "weigh": {"label": "Butter", "grams": 10}},
    {"text": "Zwiebel und Knoblauch in der Butter andünsten.",
     "machine": {"program": "manuel", "seconds": 180, "speed": 1, "tempC": 120, "accessory": "whisk"}},
    {"text": "Zitronensaft einwiegen.", "weigh": {"label": "Zitronensaft", "grams": 10}},
    {"text": "Milch einwiegen.", "weigh": {"label": "Milch", "grams": 150}},
    {"text": "Cremefine einwiegen.", "weigh": {"label": "Cremefine", "grams": 200}},
    {"text": "Mehl einwiegen.", "weigh": {"label": "Mehl", "grams": 30}},
    {"text": "Gemüsebrühe-Würfel, Salz, Muskatnuss und Pfeffer zugeben. Aufkochen und binden lassen.",
     "machine": {"program": "manuel", "seconds": 360, "speed": 2, "tempC": 100, "accessory": "whisk"}},
    {"text": "Rühraufsatz entfernen (Messer bleibt eingesetzt). Bohnen zugeben und im Linkslauf garen.",
     "machine": {"program": "manuel", "seconds": 240, "speed": 1, "tempC": 100, "reverse": true}},
    {"text": "Zucchiniwürfel, Lachswürfel und Dillspitzen zugeben. Zitronensaft einwiegen.", "weigh": {"label": "Zitronensaft", "grams": 15}},
    {"text": "Lachs und Zucchini sanft im Linkslauf garen.",
     "machine": {"program": "manuel", "seconds": 480, "speed": 1, "tempC": 90, "reverse": true}},
    {"text": "Soße mit Salz und Zitronensaft abschmecken, mit den Nudeln vermengen und servieren."}
